# ==============================================================================
# پیکربندی متغیرهای محیطی پروژه خطی‌نو (Khatinoo Environment Variables)
# ==============================================================================

# 1. تنظیمات پورت و محیط اجرا
PORT=3000
NODE_ENV=production
APP_URL=https://khatynoo.ir

# 2. کلید امنیتی نشست‌ها و احراز هویت توکن JWT
JWT_SECRET=khatinoo_super_secret_jwt_key_2026_stationery_store

# 3. تنظیمات پایگاه داده PostgreSQL در شبکه Docker
# سرویس db در داکر کامپوز به عنوان نام هاست استفاده می‌شود
POSTGRES_DB=khatinoo_db
POSTGRES_USER=khatinoo_user
POSTGRES_PASSWORD=secure_khatinoo_db_password_2026

# رشته اتصال برای اتصال اپلیکیشن به کانتینر دیتابیس درون شبکه داکر
DATABASE_URL=postgresql://khatinoo_user:secure_khatinoo_db_password_2026@db:5432/khatinoo_db

# 4. کلید هوش مصنوعی Google Gemini (جهت دستیار هوشمند و تحلیل بازار)
GEMINI_API_KEY=

# 5. تنظیمات کارتخوان شبکه پاسارگاد (POS Integration)
POS_PASARGAD_IP=192.168.1.150
POS_PASARGAD_PORT=7000
POS_PASARGAD_TERMINAL_ID=12345678
POS_PASARGAD_MERCHANT_ID=87654321


