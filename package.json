  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -r ./security-bootstrap.cjs ./node_modules/tsx/dist/cli.mjs server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node -r ./security-bootstrap.cjs dist/server.cjs",
    "db:init": "tsx server/initDb.ts",
    "db:migrate": "tsx server/migrate.ts",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^3.0.0",
